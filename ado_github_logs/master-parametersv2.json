{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "subscriptionId": {
      "value": "",
      "metadata": {
        "description": "Azure Subscription ID."
      }
    },
    "tenantId": {
      "value": "",
      "metadata": {
        "description": "Azure AD Tenant ID."
      }
    },
    "resourceGroupName": {
      "value": "",
      "metadata": {
        "description": "Resource Group containing the workspace."
      }
    },
    "workspaceName": {
      "value": "",
      "metadata": {
        "description": "Log Analytics Workspace name."
      }
    },
    "DCEName": {
      "value": "",
      "metadata": {
        "description": "Data Collection Endpoint name."
      }
    },
    "DCRName": {
      "value": "",
      "metadata": {
        "description": "Data Collection Rule name."
      }
    },
    "Region": {
      "value": "",
      "metadata": {
        "description": "Azure region (e.g., southeastasia)."
      }
    },
    "streamName": {
      "value": "",
      "metadata": {
        "description": "Stream name (e.g., Custom-GitHubLogs_CL)."
      }
    },
    "tableName": {
      "value": "",
      "metadata": {
        "description": "Custom table name (e.g., GitHubLogs_CL)."
      }
    }
  }
}
